{
  "name": "mybook",
  "version": "0.1.0",
  "description": "MyBook — e-commerce de livros (Node.js + Express + PostgreSQL)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/unit.test.js",
    "test:integration": "node --test test/integration.test.js",
    "db:reset": "docker compose down -v && docker compose up -d --build db"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "ejs": "^6.0.1",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "helmet": "^8.2.0",
    "multer": "^2.2.0",
    "pg": "^8.11.5"
  }
}
