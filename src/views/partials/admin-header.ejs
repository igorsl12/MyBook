<div class="admin-shell">
  <aside class="admin-sidebar">
    <a class="brand" href="/admin">My<b>Book</b> <span class="admin-tag">admin</span></a>
    <nav>
      <a href="/admin" class="<%= currentPath === '/admin' ? 'active' : '' %>">Dashboard</a>
      <a href="/admin/livros" class="<%= currentPath.startsWith('/admin/livros') ? 'active' : '' %>">Livros</a>
      <a href="/admin/catalogo" class="<%= currentPath.startsWith('/admin/catalogo') ? 'active' : '' %>">Autores · Editoras · Categorias</a>
      <a href="/admin/pedidos" class="<%= currentPath.startsWith('/admin/pedidos') ? 'active' : '' %>">Pedidos</a>
      <a href="/admin/cupons" class="<%= currentPath.startsWith('/admin/cupons') ? 'active' : '' %>">Cupons</a>
    </nav>
    <div class="admin-sidebar-foot">
      <a href="/">← Voltar à loja</a>
      <form action="/sair" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-ghost" type="submit">Sair</button></form>
    </div>
  </aside>
  <main class="admin-main">
    <% if (flash && flash.length) { %><% flash.forEach(function(f){ %><div class="alert alert-<%= f.tipo %>" role="status"><%= f.mensagem %></div><% }) %><% } %>
