<%- include('../partials/head') %>
<%- include('../partials/header') %>

<h1>Finalizar compra</h1>

<form action="/checkout/finalizar" method="post">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <div class="checkout-layout">
    <div class="checkout-main">

      <!-- Etapa 1: Endereço -->
      <section class="card checkout-step">
        <h2>1. Endereço de entrega</h2>
        <% if (enderecos.length) { %>
          <div class="address-list">
            <% enderecos.forEach(function(e){ %>
              <label class="address-option <%= enderecoId === e.id ? 'selected' : '' %>">
                <input type="radio" name="endereco_id" value="<%= e.id %>" <%= enderecoId === e.id ? 'checked' : '' %>>
                <span>
                  <strong><%= e.logradouro %>, <%= e.numero %></strong><% if (e.complemento) { %> — <%= e.complemento %><% } %><br>
                  <span class="muted"><%= e.bairro %>, <%= e.cidade %>/<%= e.uf %> · CEP <%= e.cep %></span>
                </span>
              </label>
            <% }) %>
          </div>
        <% } else { %>
          <p class="muted">Você ainda não tem endereços salvos. Cadastre um abaixo.</p>
        <% } %>

        <details class="new-address" <%= enderecos.length === 0 ? 'open' : '' %>>
          <summary>+ Cadastrar novo endereço</summary>
          <div class="new-address-form">
            <% const ne = typeof novoEndereco !== 'undefined' ? novoEndereco : {}; %>
            <div class="form-grid">
              <div class="form-group"><label>CEP</label><input class="form-control" name="cep" aria-label="CEP" data-cep value="<%= ne.cep || '' %>" placeholder="00000-000"><% if (erros.cep) { %><div class="field-error"><%= erros.cep %></div><% } %></div>
              <div class="form-group span2"><label>Logradouro</label><input class="form-control" name="logradouro" aria-label="Logradouro" value="<%= ne.logradouro || '' %>"><% if (erros.logradouro) { %><div class="field-error"><%= erros.logradouro %></div><% } %></div>
              <div class="form-group"><label>Número</label><input class="form-control" name="numero" aria-label="Número" value="<%= ne.numero || '' %>"><% if (erros.numero) { %><div class="field-error"><%= erros.numero %></div><% } %></div>
              <div class="form-group"><label>Complemento</label><input class="form-control" name="complemento" aria-label="Complemento" value="<%= ne.complemento || '' %>"></div>
              <div class="form-group"><label>Bairro</label><input class="form-control" name="bairro" aria-label="Bairro" value="<%= ne.bairro || '' %>"><% if (erros.bairro) { %><div class="field-error"><%= erros.bairro %></div><% } %></div>
              <div class="form-group"><label>Cidade</label><input class="form-control" name="cidade" aria-label="Cidade" value="<%= ne.cidade || '' %>"><% if (erros.cidade) { %><div class="field-error"><%= erros.cidade %></div><% } %></div>
              <div class="form-group"><label>UF</label><input class="form-control" name="uf" aria-label="UF" maxlength="2" value="<%= ne.uf || '' %>"><% if (erros.uf) { %><div class="field-error"><%= erros.uf %></div><% } %></div>
            </div>
            <button class="btn btn-outline" type="submit" formaction="/checkout/endereco">Salvar endereço</button>
          </div>
        </details>
      </section>

      <!-- Etapa 2: Frete -->
      <section class="card checkout-step">
        <h2>2. Frete</h2>
        <div class="cep-row">
          <input class="form-control" form="frete-form" name="cep" value="<%= cep %>" placeholder="Seu CEP (00000-000)">
          <button class="btn btn-outline" type="submit" form="frete-form">Calcular</button>
        </div>
        <% if (frete) { %>
          <div class="frete-result">
            <% if (frete.gratis) { %>
              <strong class="text-green">Frete grátis!</strong>
            <% } else { %>
              <strong><%= formatBRL(frete.freteCents) %></strong>
            <% } %>
            <span class="muted">· <%= frete.regiao %> · entrega em até <%= frete.prazoDias %> dias úteis</span>
          </div>
        <% } else { %>
          <p class="muted">Informe seu CEP para calcular o frete.</p>
        <% } %>
      </section>

      <!-- Etapa 3: Pagamento -->
      <section class="card checkout-step">
        <h2>3. Pagamento <span class="badge-sandbox">sandbox</span></h2>
        <div class="pay-methods">
          <label class="pay-option"><input type="radio" name="metodo" value="pix" <%= metodo === 'pix' ? 'checked' : '' %>> <span>PIX <small class="muted">(aprovação simulada)</small></span></label>
          <label class="pay-option"><input type="radio" name="metodo" value="cartao" <%= metodo === 'cartao' ? 'checked' : '' %>> <span>Cartão de crédito</span></label>
          <label class="pay-option"><input type="radio" name="metodo" value="boleto" <%= metodo === 'boleto' ? 'checked' : '' %>> <span>Boleto</span></label>
        </div>
        <div class="card-fields">
          <p class="muted" style="font-size:.85rem">Dados de cartão são apenas para a simulação — nada é cobrado nem armazenado.</p>
          <div class="form-grid">
            <div class="form-group span2"><label>Número do cartão</label><input class="form-control" name="cartao_numero" placeholder="4111 1111 1111 1111" inputmode="numeric"></div>
            <div class="form-group"><label>Validade</label><input class="form-control" name="cartao_validade" placeholder="MM/AA"></div>
            <div class="form-group"><label>CVV</label><input class="form-control" name="cartao_cvv" placeholder="123" inputmode="numeric"></div>
          </div>
        </div>
      </section>
    </div>

    <!-- Resumo -->
    <aside class="checkout-summary card">
      <h2>Resumo</h2>
      <ul class="summary-items">
        <% itens.forEach(function(it){ %>
          <li><span><%= it.quantidade %>× <%= it.titulo %></span><span><%= formatBRL(it.subtotalCents) %></span></li>
        <% }) %>
      </ul>
      <div class="summary-row"><span>Subtotal</span><span><%= formatBRL(subtotalCents) %></span></div>
      <% if (descontoCents > 0) { %><div class="summary-row text-green"><span>Desconto (<%= cupom.codigo %>)</span><span>− <%= formatBRL(descontoCents) %></span></div><% } %>
      <div class="summary-row"><span>Frete</span><span><%= frete ? (frete.gratis ? 'Grátis' : formatBRL(freteCents)) : '—' %></span></div>
      <div class="summary-row total"><span>Total</span><strong><%= formatBRL(totalCents) %></strong></div>

      <button class="btn btn-primary btn-block" type="submit">Confirmar pedido</button>
      <a class="btn btn-ghost btn-block" href="/carrinho" style="margin-top:.3rem">Voltar ao carrinho</a>
    </aside>
  </div>
</form>

<!-- Form auxiliar do frete (o CEP usa o atributo form="frete-form") -->
<form id="frete-form" action="/checkout/frete" method="post" hidden><input type="hidden" name="_csrf" value="<%= csrfToken %>"></form>

<!-- Cupom -->
<form action="/checkout/cupom" method="post" class="cupom-form">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input class="form-control" name="cupom" placeholder="Cupom de desconto" value="<%= cupom ? cupom.codigo : '' %>">
  <button class="btn btn-outline" type="submit">Aplicar</button>
</form>

<%- include('../partials/footer') %>
