<%- include('../partials/head') %>
<%- include('../partials/header') %>

<%
  const pag = pedido.pagamento_json || {};
  const end = pedido.endereco_json || {};
  const ehDono = typeof dono !== 'undefined' ? dono : false;
  const jaAvaliados = typeof avaliados !== 'undefined' ? avaliados : new Set();
  // Avaliação só após o produto ser recebido (entregue) e vale só p/ este pedido.
  const podeAvaliar = ehDono && ['entregue','reembolso_solicitado','reembolsado'].includes(pedido.status);
  const podeReembolso = ehDono && pedido.status === 'entregue';
%>

<div class="confirm-hero">
  <div class="confirm-check" aria-hidden="true"><%= pedido.status === 'cancelado' || pedido.status === 'reembolsado' ? '↩' : '✓' %></div>
  <h1>Pedido #<%= pedido.id %></h1>
  <p class="muted">Status: <span class="badge badge-<%= statusCor(pedido.status) %>"><%= statusLabel(pedido.status) %></span></p>
</div>

<div class="confirm-layout">
  <section class="card">
    <h2>Pagamento <span class="badge-sandbox">sandbox</span></h2>
    <% if (pag.metodo === 'pix') { %>
      <p>Pague via <strong>PIX</strong> escaneando o QR abaixo (simulado):</p>
      <div class="qr-box"><img alt="QR Code PIX (simulado)" src="data:image/svg+xml;base64,<%= Buffer.from(String(pag.qrSvg || '')).toString('base64') %>"></div>
      <label class="form-help">PIX copia e cola:</label>
      <input class="form-control" readonly value="<%= pag.copiaECola %>" data-select-on-click>
      <p class="muted"><%= pag.instrucao %></p>
    <% } else if (pag.metodo === 'boleto') { %>
      <p>Boleto gerado (simulado). Vencimento: <strong><%= pag.vencimento %></strong></p>
      <label class="form-help">Linha digitável:</label>
      <input class="form-control" readonly value="<%= pag.linhaDigitavel %>" data-select-on-click>
      <p class="muted"><%= pag.instrucao %></p>
    <% } else if (pag.metodo === 'cartao') { %>
      <p>Pagamento aprovado no <strong><%= pag.bandeira %></strong> final <strong><%= pag.ultimos4 %></strong> (simulado).</p>
      <p class="muted">Autorização: <%= pag.autorizacao %></p>
    <% } %>
  </section>

  <aside class="card">
    <h2>Resumo</h2>
    <ul class="summary-items">
      <% pedido.itens.forEach(function(it){ %>
        <li><span><%= it.quantidade %>× <%= it.titulo %></span><span><%= formatBRL(toCents(it.preco_unitario) * it.quantidade) %></span></li>
      <% }) %>
    </ul>
    <div class="summary-row"><span>Subtotal</span><span><%= formatBRL(toCents(pedido.subtotal)) %></span></div>
    <% if (Number(pedido.desconto) > 0) { %><div class="summary-row text-green"><span>Desconto</span><span>− <%= formatBRL(toCents(pedido.desconto)) %></span></div><% } %>
    <div class="summary-row"><span>Frete</span><span><%= Number(pedido.frete) === 0 ? 'Grátis' : formatBRL(toCents(pedido.frete)) %></span></div>
    <div class="summary-row total"><span>Total</span><strong><%= formatBRL(toCents(pedido.total)) %></strong></div>

    <h3 style="margin-top:1.25rem">Entrega</h3>
    <p class="muted">
      <%= end.logradouro %>, <%= end.numero %><% if (end.complemento) { %> — <%= end.complemento %><% } %><br>
      <%= end.bairro %>, <%= end.cidade %>/<%= end.uf %> · CEP <%= end.cep %>
    </p>
  </aside>
</div>

<% if (ehDono && (podeAvaliar || podeReembolso || pedido.status === 'reembolso_solicitado' || pedido.status === 'reembolsado')) { %>
<section class="card" style="margin-top:1.25rem">
  <h2>Seus produtos</h2>

  <% if (pedido.status === 'reembolso_solicitado') { %>
    <div class="alert alert-aviso">Reembolso em análise pela nossa equipe. Avisaremos assim que for processado.</div>
  <% } else if (pedido.status === 'reembolsado') { %>
    <div class="alert alert-erro">Este pedido foi reembolsado.</div>
  <% } %>

  <% if (!podeAvaliar) { %>
    <p class="muted">Você poderá avaliar os produtos deste pedido após a entrega.</p>
  <% } %>

  <ul class="produto-actions">
    <% pedido.itens.forEach(function(it){ %>
      <li class="produto-review-item">
        <div class="produto-review-head">
          <span><%= it.titulo %></span>
          <% if (podeAvaliar && jaAvaliados.has(it.livro_id)) { %>
            <span class="badge badge-sucesso">Avaliado ✓</span>
          <% } %>
        </div>

        <% if (podeAvaliar && !jaAvaliados.has(it.livro_id)) { %>
          <details class="review-inline">
            <summary class="btn btn-outline">★ Avaliar este produto</summary>
            <form class="review-form" action="/pedido/<%= pedido.id %>/avaliar/<%= it.livro_id %>" method="post" enctype="multipart/form-data">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="form-group">
                <label for="nota-<%= it.livro_id %>">Sua nota</label>
                <select class="form-control" id="nota-<%= it.livro_id %>" name="nota" style="max-width:120px">
                  <% for (let n = 5; n >= 1; n--) { %><option value="<%= n %>"><%= n %> ★</option><% } %>
                </select>
              </div>
              <div class="form-group">
                <label for="coment-<%= it.livro_id %>">Comentário (opcional)</label>
                <textarea class="form-control" id="coment-<%= it.livro_id %>" name="comentario" rows="3"></textarea>
              </div>
              <div class="form-group">
                <label for="midias-<%= it.livro_id %>">Fotos e vídeos (opcional)</label>
                <input class="form-control" id="midias-<%= it.livro_id %>" type="file" name="midias" accept="image/*,video/*" multiple>
                <span class="form-help">Até 5 arquivos (imagens ou vídeos), 20&nbsp;MB cada.</span>
              </div>
              <button class="btn btn-primary" type="submit">Enviar avaliação</button>
            </form>
          </details>
        <% } %>
      </li>
    <% }) %>
  </ul>

  <% if (podeReembolso) { %>
    <form action="/pedido/<%= pedido.id %>/reembolso" method="post" data-confirm="Solicitar reembolso deste pedido entregue?" style="margin-top:1rem">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn-outline" type="submit">↩ Solicitar reembolso</button>
      <span class="form-help">Disponível porque o pedido foi entregue.</span>
    </form>
  <% } %>
</section>
<% } %>

<div class="text-center" style="margin:2rem 0">
  <a class="btn btn-primary" href="/minha-conta/pedidos">Ver meus pedidos</a>
  <a class="btn btn-outline" href="/catalogo">Continuar comprando</a>
</div>

<%- include('../partials/footer') %>
