<%- include('../partials/head') %>
<%- include('../partials/header') %>

<%
  const pag = pedido.pagamento_json || {};
  const end = pedido.endereco_json || {};
%>

<div class="confirm-hero">
  <div class="confirm-check" aria-hidden="true">✓</div>
  <h1>Pedido #<%= pedido.id %> confirmado</h1>
  <p class="muted">Status: <span class="badge badge-<%= statusCor(pedido.status) %>"><%= statusLabel(pedido.status) %></span></p>
</div>

<div class="confirm-layout">
  <section class="card">
    <h2>Pagamento <span class="badge-sandbox">sandbox</span></h2>
    <% if (pag.metodo === 'pix') { %>
      <p>Pague via <strong>PIX</strong> escaneando o QR abaixo (simulado):</p>
      <div class="qr-box"><%- pag.qrSvg %></div>
      <label class="form-help">PIX copia e cola:</label>
      <input class="form-control" readonly value="<%= pag.copiaECola %>" data-select-on-click>
      <p class="muted"><%= pag.instrucao %></p>
    <% } else if (pag.metodo === 'boleto') { %>
      <p>Boleto gerado (simulado). Vencimento: <strong><%= pag.vencimento %></strong></p>
      <label class="form-help">Linha digitável:</label>
      <input class="form-control" readonly value="<%= pag.linhaDigitavel %>" data-select-on-click>
      <p class="muted"><%= pag.instrucao %></p>
    <% } else if (pag.metodo === 'cartao') { %>
      <p>Pagamento aprovado no <strong><%= pag.bandeira %></strong> final <strong><%= pag.ultimos4 %></strong> (simulado).</p>
      <p class="muted">Autorização: <%= pag.autorizacao %></p>
    <% } %>
  </section>

  <aside class="card">
    <h2>Resumo</h2>
    <ul class="summary-items">
      <% pedido.itens.forEach(function(it){ %>
        <li><span><%= it.quantidade %>× <%= it.titulo %></span><span><%= formatBRL(toCents(it.preco_unitario) * it.quantidade) %></span></li>
      <% }) %>
    </ul>
    <div class="summary-row"><span>Subtotal</span><span><%= formatBRL(toCents(pedido.subtotal)) %></span></div>
    <% if (Number(pedido.desconto) > 0) { %><div class="summary-row text-green"><span>Desconto</span><span>− <%= formatBRL(toCents(pedido.desconto)) %></span></div><% } %>
    <div class="summary-row"><span>Frete</span><span><%= Number(pedido.frete) === 0 ? 'Grátis' : formatBRL(toCents(pedido.frete)) %></span></div>
    <div class="summary-row total"><span>Total</span><strong><%= formatBRL(toCents(pedido.total)) %></strong></div>

    <h3 style="margin-top:1.25rem">Entrega</h3>
    <p class="muted">
      <%= end.logradouro %>, <%= end.numero %><% if (end.complemento) { %> — <%= end.complemento %><% } %><br>
      <%= end.bairro %>, <%= end.cidade %>/<%= end.uf %> · CEP <%= end.cep %>
    </p>
  </aside>
</div>

<div class="text-center" style="margin:2rem 0">
  <a class="btn btn-primary" href="/minha-conta/pedidos">Ver meus pedidos</a>
  <a class="btn btn-outline" href="/catalogo">Continuar comprando</a>
</div>

<%- include('../partials/footer') %>
