<%- include('../partials/head') %>
<%- include('../partials/header') %>

<div class="account-layout">
  <%- include('_nav') %>
  <div class="account-main">
    <h1>Meu perfil</h1>
    <form class="card" action="/minha-conta/perfil" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-grid form-grid-2">
        <div class="form-group">
          <label for="email">E-mail</label>
          <input class="form-control" id="email" type="email" value="<%= perfil.email %>" disabled>
          <div class="form-help">O e-mail de acesso não pode ser alterado.</div>
        </div>
        <div class="form-group">
          <label for="nome">Nome</label>
          <input class="form-control" id="nome" name="nome" value="<%= perfil.nome || '' %>" required>
          <% if (erros.nome) { %><div class="field-error"><%= erros.nome %></div><% } %>
        </div>
        <div class="form-group">
          <label for="telefone">Telefone</label>
          <input class="form-control" id="telefone" name="telefone" value="<%= perfil.telefone || '' %>" placeholder="(11) 90000-0000">
        </div>
        <div class="form-group">
          <label for="cpf">CPF</label>
          <input class="form-control" id="cpf" name="cpf" value=""
                 placeholder="<%= cpfMascarado ? cpfMascarado + ' (preencha só para alterar)' : '000.000.000-00' %>"
                 autocomplete="off" inputmode="numeric">
          <div class="form-help">Guardado criptografado. <% if (cpfMascarado) { %>Deixe em branco para manter o atual.<% } %></div>
          <% if (erros.cpf) { %><div class="field-error"><%= erros.cpf %></div><% } %>
        </div>
      </div>
      <button class="btn btn-primary" type="submit">Salvar</button>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
