# Copie para .env e ajuste os valores. NUNCA comite o .env real.
# cp .env.example .env

# --- Aplicação ---
NODE_ENV=development
# Porta exposta da API no host
PORT=3000
# Segredo de assinatura da sessão (gere um aleatório em produção):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque_este_segredo_em_producao
# Frete grátis para pedidos acima deste valor (em reais)
FRETE_GRATIS_ACIMA=150
# URL pública canônica (opcional). Se definida, é usada em sitemap.xml/robots.txt
# em vez do header Host (mitiga host header injection). Ex.: https://mybook.com.br
# SITE_URL=https://mybook.com.br

# --- Banco de dados PostgreSQL ---
DB_USER=livraria
DB_PASSWORD=troque_esta_senha
DB_NAME=livraria
DB_PORT=5432
# Host do banco: "db" dentro do docker-compose; "localhost" se rodar a app fora do container.
DB_HOST=db
DB_POOL_MAX=10
